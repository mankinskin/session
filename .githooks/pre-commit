#!/usr/bin/env bash
# Hard-block staged guidance commits that contain broken local Markdown links.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"
staged_files="$(git diff --cached --name-only)"

if [[ -z "$staged_files" ]]; then
    exit 0
fi

if ! printf '%s\n' "$staged_files" | grep -Eq '(^|/)\.agents/.*\.md$|(^|/)AGENTS\.md$'; then
    exit 0
fi

auditor="${AUDIT_BIN:-}"
if [[ -z "$auditor" ]]; then
    for candidate in \
        "$repo_root/workflow-tools/target/debug/audit.exe" \
        "$repo_root/../workflow-tools/target/debug/audit.exe" \
        "$repo_root/target/debug/audit.exe" \
        "$repo_root/workflow-tools/target/debug/audit" \
        "$repo_root/../workflow-tools/target/debug/audit" \
        "$repo_root/target/debug/audit"; do
        if [[ -x "$candidate" ]]; then
            auditor="$candidate"
            break
        fi
    done
fi

if [[ -z "$auditor" ]]; then
    auditor="$(command -v audit || true)"
fi

if [[ -z "$auditor" ]]; then
    echo "pre-commit: audit hook command unavailable; build audit-cli or set AUDIT_BIN" >&2
    exit 1
fi

audit_root="$repo_root"
while superproject_root="$(git -C "$audit_root" rev-parse --show-superproject-working-tree 2>/dev/null)"; do
    if [[ -n "$superproject_root" ]]; then
        audit_root="$superproject_root"
    else
        break
    fi
done

if ! "$auditor" hook "$audit_root"; then
    echo "pre-commit: guidance audit hook failed; repair the reported findings" >&2
    echo "pre-commit: try: install-ctl guidance autofix --repo-root $audit_root --apply --yes" >&2
    exit 1
fi
